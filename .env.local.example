# ─────────────────────────────────────────────────────────────
#  Our Little World — environment variables
#  Salin file ini menjadi .env.local lalu isi nilainya.
#  Di Vercel: Settings → Environment Variables (atau `vercel env pull .env.local`)
# ─────────────────────────────────────────────────────────────

# ── Neon Postgres (otomatis terisi via Vercel → Storage → Neon) ──
DATABASE_URL="postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Vercel Blob (otomatis terisi saat membuat Blob store & connect ke project) ──
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# ── Passcode Gate ──
# Kode rahasia yang diketik di lock screen (min. 4 karakter)
APP_PASSCODE="ganti-dengan-kode-rahasia"
# Kunci tanda tangan cookie, min. 32 karakter acak → `npm run gen:secret`
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Berapa hari tetap login di HP sebelum diminta passcode lagi
SESSION_MAX_AGE_DAYS="30"

# ── Opsional ──
NEXT_PUBLIC_APP_NAME="Our Little World"
